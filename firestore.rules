rules_version = '2';

// Source of truth for the mobile app's Firestore security rules. Historically
// these lived only in the Firebase Console (see docs/demo-cohort-report.md's
// note about the isAdmin() rule) — this file exists so new collections don't
// silently ship without rules again. Paste the relevant match block into the
// Console's Rules tab (Firestore Database → Rules → Publish) whenever this
// file changes; there's no `firebase.json` in this repo yet to `firebase
// deploy --only firestore:rules` directly.
//
// The `users`/isAdmin() block below is a best-effort reconstruction from the
// admin email allowlist in apps/mobile/adminAuth.ts — verify it against
// whatever is actually published in the Console before relying on it, since
// this file couldn't be generated from the live source of truth.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["aaryamanchopra25@outlook.com"];
    }

    // Community-visible drives, one flat collection for every user. Doc id
    // is `{uid}_{driveId}` (apps/mobile/cloudDrives.ts).
    match /drives/{driveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Profile docs, doc id = uid (apps/mobile/cloudDrives.ts upsertUserProfile).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Waze-style "report as you go" taps (apps/mobile/hazardReports.ts).
    match /hazardReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Ephemeral live-position broadcast, doc id = uid, only while actively
    // driving (apps/mobile/livePresence.ts).
    match /livePresence/{presenceUid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == presenceUid;
    }

    // Mock civic filings (apps/mobile/civicMock.ts). Only the filer's own
    // client advances status (the scripted ack/close timers run on their
    // session), so update is scoped to filedByUid, not any authenticated user.
    match /civicReports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.filedByUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.filedByUid == request.auth.uid;
      allow delete: if false;
    }

    // "This user contributed evidence to this hazard" — doc id
    // `{hazardId}_{uid}` for idempotent dedup (apps/mobile/hazardReports.ts).
    match /hazardContributions/{contributionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
