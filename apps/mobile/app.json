{
  "expo": {
    "name": "StreetSmart",
    "slug": "streetsmart",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/mark.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "StreetSmart uses your location to place detected road hazards and measure vehicle speed."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/brand/mark.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/mark.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "StreetSmart uses the camera so you can attach a photo of a hazard to a city report."
        }
      ]
    ]
  }
}
