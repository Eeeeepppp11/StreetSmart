# Firebase Web config — from Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
# Copy this file to `.env` and fill in real values. `.env` is gitignored — never commit it.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Comma-separated list of emails allowed to see the Admin dashboard in the
# side navbar. Defaults to aaryamanchopra25@outlook.com if unset.
EXPO_PUBLIC_ADMIN_EMAILS=aaryamanchopra25@outlook.com
